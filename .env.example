# SQLite — chemin du fichier de base (local : fichier à la racine)
DATABASE_URL="file:./dev.db"

# Token MCP — générer une valeur longue et aléatoire, ne jamais committer la vraie valeur
MCP_TOKEN="change-me-generate-a-long-random-token"

# Secret de session UI (JWT cookie). En local peut reprendre MCP_TOKEN si absent.
AUTH_SECRET="change-me-auth-secret-long-random"

# Compte admin créé au seed (si absent)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="admin123!"
